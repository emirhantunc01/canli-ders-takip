{
  "name": "ders-defteri",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "build:desktop": "npm run build && tsc -p tsconfig.desktop.json",
    "desktop": "npm run build:desktop && electron .",
    "package:win": "npm run build:desktop && electron-builder --win nsis --x64",
    "test:desktop": "playwright test -c playwright.desktop.config.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Matematik dersleri ve ödeme hesapları için çevrimdışı masaüstü uygulaması",
  "author": "Emirhan Tunç",
  "main": "desktop-dist/desktop/main.js",
  "build": {
    "appId": "com.emirhantunc.dersdefteri",
    "productName": "Ders Defteri",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop-dist/**/*",
      "desktop/preload.cjs",
      "desktop/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico",
      "artifactName": "DersDefteri-Kurulum.exe",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Ders Defteri",
      "deleteAppDataOnUninstall": false
    }
  }
}
